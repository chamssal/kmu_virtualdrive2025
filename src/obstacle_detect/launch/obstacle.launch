<launch>
    <node pkg="obstacle_detect"
          name="lidar_obstacle_detect2"
          type="lidar_obstacle_detect.py"
          output="screen">
        <rosparam command="load" file="$(find obstacle_detect)/config/obstacle.yaml" />
    </node>

    <node pkg="obstacle_detect"
          name="camera_obstacle_detect"
          type="camera_obstacle_detect.py"
          output="screen" />

    <node pkg="obstacle_detect"
          name="front_wall_detector_angle"
          type="wall_ransac.py"
          output="screen" />
</launch>
