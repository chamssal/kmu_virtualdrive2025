<launch>
  <arg name="input_topic" default="/raw_obstacles"/>

  <node pkg="dynamic_obstacle" type="dynamic_obstacle.py" name="dynamic_obstacle" output="screen">
    <!-- 입력 토픽 -->
    <param name="input_topic" value="$(arg input_topic)"/>
    <param name="use_circles" value="true"/>
    <param name="use_segments" value="false"/>

    <!-- ROI/필터 파라미터 (코드 변수명에 맞춤) -->
    <param name="front_roi_min_y" value="0.7"/>
    <param name="front_roi_max_y" value="6.0"/>
    <param name="roi_half_width" value="0.8"/> <!-- 좌우 폭 -->

    <!-- 장애물 필터 -->
    <param name="lane_escape_x" value="1.2"/>

    <!-- 속도/거리 설정 -->
    <param name="speed_threshold_dynamic" value="0.3"/>
    <param name="yield_distance" value="2.5"/>
    <param name="stop_distance" value="1.2"/>
    <param name="hold_time_yield" value="1.5"/>
    <param name="target_speed_yield" value="0.5"/>

    <!-- 벽 억제용 필터 (코드에서 처리 추가 필요) -->
    <param name="max_circle_radius" value="0.6"/>
    <param name="max_segment_len" value="1.2"/>
    <param name="max_segment_side_deg" value="60"/>
  </node>
</launch>
